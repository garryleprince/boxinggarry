{
  "name": "boxing-body-coach",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Coach de préparation physique au poids du corps pour la boxe — PWA local-first",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --noEmit",
    "lint": "tsc -b",
    "verify:browser": "node tests/e2e/parcours.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
